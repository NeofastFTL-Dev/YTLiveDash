<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingTop="48dp"
        android:paddingRight="22dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.24"
            android:text="EMILLI REMOTE"
            android:textColor="@color/txt"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:text="Sign in to the streaming PC. The PIN and the address are in ./remote-url.sh on that machine."
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"
            android:text="SERVER"
            android:textColor="@color/dim"
            android:textSize="9.5sp" />

        <EditText
            android:id="@+id/setupUrl"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:hint="http://192.168.100.73:8123"
            android:inputType="textUri"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:singleLine="true"
            android:textColor="@color/txt"
            android:textColorHint="@color/faint"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"
            android:text="PIN OR TOKEN"
            android:textColor="@color/dim"
            android:textSize="9.5sp" />

        <EditText
            android:id="@+id/setupPin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:hint="8-digit PIN"
            android:inputType="textPassword|textNoSuggestions"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:singleLine="true"
            android:textColor="@color/txt"
            android:textColorHint="@color/faint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/setupGo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:text="UNLOCK"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:text=""
            android:textColor="@color/dim"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="monospace"
            android:text="On Wi-Fi use the LAN address (http://192.168.100.73:8123).\nOn mobile data use the tunnel address from remote-url.sh.\nStays signed in for a year on this phone."
            android:textColor="#4D4D58"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
