# ---------------------------------------------------------------- secrets
# config.json holds the YouTube API key, the OAuth client secret, the Ko-fi
# token, the remote access token and the OBS/VLC passwords. config.example.json
# is the committed shape of it.
config.json
yt-token.json
android/.ks-pass
android/emilli-release.keystore

